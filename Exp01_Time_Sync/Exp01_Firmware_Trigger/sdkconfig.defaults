# ==========================================
# 無人機邊緣運算節點 (Slave) 效能解放設定檔
# ==========================================

# 1. 儲存空間解封：強制指定 Flash Size 為 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# 2. 核心運算極速：強制指定雙核心 CPU 時脈為 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# 3. 記憶體通道擴充：開啟 QIO (Quad I/O) 四線傳輸模式
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"

# 4. 記憶體流速提升：強制 Flash 讀取速度提升至 80MHz
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

# ==========================================
# (選用) 針對 FreeRTOS 的效能微調
# 讓系統能以 1000Hz (1ms) 的頻率切換任務，對應高頻率 BLE 接收
# ==========================================
CONFIG_FREERTOS_HZ=1000